+package com.loohp.interactivechatdiscordsrvaddon.utils;
+
+import com.loohp.interactivechat.InteractiveChat;
+import com.loohp.interactivechat.libs.com.google.gson.Gson;
+import com.loohp.interactivechat.libs.com.google.gson.reflect.TypeToken;
+import com.loohp.interactivechat.utils.LanguageUtils;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStreamReader;
+import java.lang.reflect.Type;
+import java.nio.charset.StandardCharsets;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Reads InteractiveChat's on-disk language files before falling back to its
+ * in-memory language cache. The cache used by LanguageUtils is not guaranteed
+ * to include every language file after a resource reload.
+ */
+public final class InteractiveChatLanguageLoader {
+
+    private static final Gson GSON = new Gson();
+    private static final Type LANGUAGE_MAP_TYPE = new TypeToken<Map<String, String>>() {}.getType();
+    private static final Map<String, CachedLanguage> CACHE = new ConcurrentHashMap<>();
+
+    private InteractiveChatLanguageLoader() {
+    }
+
+    public static String getTranslation(String translationKey, String fallback, String language) {
+        String translation = getTranslations(language).get(translationKey);
+        if (translation != null) {
+            return translation;
+        }
+        String fallbackTranslation = LanguageUtils.getTranslation(translationKey, language).getResultOrFallback(fallback);
+        return fallbackTranslation == null ? translationKey : fallbackTranslation;
+    }
+
+    private static Map<String, String> getTranslations(String language) {
+        File file = new File(InteractiveChat.plugin.getDataFolder(), "lang/languages/" + language + ".json");
+        long lastModified = file.isFile() ? file.lastModified() : -1L;
+        CachedLanguage cached = CACHE.get(language);
+        if (cached != null && cached.lastModified == lastModified) {
+            return cached.translations;
+        }
+
+        Map<String, String> translations = new HashMap<>();
+        if (lastModified >= 0L) {
+            try (InputStreamReader reader = new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8)) {
+                Map<String, String> loaded = GSON.fromJson(reader, LANGUAGE_MAP_TYPE);
+                if (loaded != null) {
+                    translations.putAll(loaded);
+                }
+            } catch (Exception ignored) {
+            }
+        }
+
+        Map<String, String> result = Collections.unmodifiableMap(translations);
+        CACHE.put(language, new CachedLanguage(lastModified, result));
+        return result;
+    }
+
+    private static final class CachedLanguage {
+
+        private final long lastModified;
+        private final Map<String, String> translations;
+
+        private CachedLanguage(long lastModified, Map<String, String> translations) {
+            this.lastModified = lastModified;
+            this.translations = translations;
+        }
+    }
+}
