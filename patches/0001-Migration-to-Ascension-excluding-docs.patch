+        return toolTipComponents.stream().map(toolTipComponent -> {
+            Component component = null;
+
+            if (toolTipComponent.getType().equals(ToolTipType.TEXT)) {
+                component = toolTipComponent.getToolTipComponent(ToolTipType.TEXT);
+            } else if (toolTipComponent.getType().equals(ToolTipType.IMAGE)) {
+                component = imageToolTipHandler.apply((ToolTipComponent<BufferedImage>) toolTipComponent);
+            }
+
+            if (component != null) {
+                // 1. Resolve translations/placeholders using InteractiveChat's utility
+                Component resolved = ComponentStringUtils.resolve(component, translationFunction);
+
+                // 2. Serialize to text (Replacing the missing DiscordSerializer)
+                // Using plain text ensures the tooltip is readable.
+                // Note: Standard Discord markdown (bold/italics) from the Minecraft component
+                // is not automatically generated by PlainTextComponentSerializer.
+                return PlainTextComponentSerializer.plainText().serialize(resolved);
+            }
+            return "";
+        }).collect(Collectors.joining("\n"));
