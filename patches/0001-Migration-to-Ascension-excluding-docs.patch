+
+            otherEmbedBuilder.setColor(color);
+            
+            if (i < imageUrl.size()) {
+                otherEmbedBuilder.setImageUrl(imageUrl.get(i));
+            }
+            
+            if (i < description.size()) {
+                otherEmbedBuilder.setDescription(description.get(i));
+            }
+            
+            // Add footer to last embed
+            if (!(i + 1 < imageUrl.size() || i + 1 < description.size())) {
+                if (footer != null) {
+                    otherEmbedBuilder.setFooter(footer, footerImageUrl);
+                }
+            }
+            
+            builder.addEmbed(otherEmbedBuilder.build());
+        }
+        
+        // Add attachments
+        for (Entry<String, byte[]> entry : attachments.entrySet()) {
+            builder.addAttachment(new java.io.ByteArrayInputStream(entry.getValue()), entry.getKey());
+        }
