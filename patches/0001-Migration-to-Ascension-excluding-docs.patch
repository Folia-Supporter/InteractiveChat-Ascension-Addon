+            embedBuilder.addField(field.getName(), field.getValue(), field.isInline());
+        }
+        
+        // Add description
+        if (description.size() > 0) {
+            embedBuilder.setDescription(description.get(0));
+        }
+        
+        // Add image
+        if (imageUrl.size() > 0) {
+            embedBuilder.setImageUrl(imageUrl.get(0));
+        }
+        
+        // Add footer
+        if (imageUrl.size() == 1 || description.size() == 1) {
+            if (footer != null) {
+                embedBuilder.setFooter(footer, footerImageUrl);
+            }
+        }
+        
+        builder.addEmbed(embedBuilder.build());
+        
+        // Add additional embeds for extra images/descriptions
+        for (int i = 1; i < imageUrl.size() || i < description.size(); i++) {
